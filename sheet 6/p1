public class CashRegister {
    private int itemCount;
    private double totalPrise;
    
public CashRegister (){
   itemCount=0;
    totalPrise=0.0;
}
public  CashRegister(int itemCount ,  double totalePrise ){
    this. itemCount= itemCount;
    this. totalPrise= totalePrise;
}
public void addItem (double prise){
    itemCount++;
    totalPrise+=prise;
}
public void clear(){
    itemCount=0;
      totalPrise=0.0;
}
public int getItemCount(){
    return itemCount;
}
public double getTotalPrice(){
    return totalPrise;
}

