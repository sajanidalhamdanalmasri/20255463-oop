import java.util.Scanner;

public class Q3 {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        char[][] grid = new char[3][4];

        System.out.println("Enter 3 words (4 letters each): ");
        for (int i = 0; i < 3; i++) {
            String word = in.next();
            for (int j = 0; j < 4; j++) {
                grid[i][j] = word.charAt(j);
            }
        }

        // 1. Print the grid
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 4; j++) {
                System.out.print(grid[i][j]);
                if (j < 3) System.out.print(" ");
            }
            System.out.println();
        }

        // 2. Columns as words (using String and concat)
        System.out.print("Columns:");
        for (int j = 0; j < 4; j++) {
            String col = "";
            for (int i = 0; i < 3; i++) {
                col = col.concat(String.valueOf(grid[i][j]));
            }
            System.out.print(" " + col);
        }
        System.out.println();

        // 3. Count vowels
        int vowels = 0;
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 4; j++) {
                if ("aeiou".indexOf(grid[i][j]) != -1) {
                    vowels++;
                }
            }
        }
        System.out.println("Vowels: " + vowels);
    }
}
